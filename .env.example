APP_ENV=development
API_PORT=8000
WEB_PORT=3000
# Copy to .env and supply private local values before starting Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=restaurant_ai
# Generate these private runtime values with the management prepare command.
APP_DB_USER=
APP_DB_PASSWORD=
# Credentials are supplied separately through the standard PostgreSQL variables.
DATABASE_URL=postgresql+psycopg://db
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local development only. HTTPS deployments must set COOKIE_SECURE=true.
COOKIE_SECURE=false
